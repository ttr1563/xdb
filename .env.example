# Local runtime only. Never commit real credentials.
XDB_HOST=127.0.0.1
XDB_PORT=4310
XDB_DATABASE_PATH=.data/xdb.sqlite
XDB_ARTIFACTS_PATH=.data/artifacts

# Optional Claude planning provider. Set all three values before selecting
# anthropic in the UI. Model names are intentionally not hard-coded.
XDB_ANTHROPIC_API_KEY=
XDB_ANTHROPIC_MODEL=
XDB_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional external adapters. Keep disabled until the matching account and
# authorization have been confirmed.
XDB_FIGMA_MCP_SERVER=
XDB_IMAGE_PROVIDER=
XDB_IMAGE_API_KEY=
