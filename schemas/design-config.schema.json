{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdb.local/schemas/design-config.schema.json",
  "title": "XDB design configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "output", "ai", "figma", "html", "illustration", "evaluation", "knowledge"],
  "properties": {
    "version": { "const": 1 },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultMode", "availableModes"],
      "properties": {
        "defaultMode": { "enum": ["figma", "html", "both"] },
        "availableModes": {
          "type": "array",
          "items": { "enum": ["figma", "html", "both"] },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultProvider", "providers"],
      "properties": {
        "defaultProvider": { "enum": ["local", "anthropic"] },
        "providers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local", "anthropic"],
          "properties": {
            "local": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": { "enabled": { "type": "boolean" } }
            },
            "anthropic": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "allowExternalRequests", "fallbackToLocal", "allowedBaseUrls", "timeoutMs", "maxOutputTokens", "maxRetries", "retryBaseDelayMs", "monthlyTokenBudget"],
              "properties": {
                "enabled": { "type": "boolean" },
                "allowExternalRequests": { "type": "boolean" },
                "fallbackToLocal": { "type": "boolean" },
                "allowedBaseUrls": {
                  "type": "array",
                  "items": { "type": "string", "format": "uri" },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
                "maxOutputTokens": { "type": "integer", "minimum": 256, "maximum": 32000 },
                "maxRetries": { "type": "integer", "minimum": 0, "maximum": 2 },
                "retryBaseDelayMs": { "type": "integer", "minimum": 100, "maximum": 10000 },
                "monthlyTokenBudget": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "figma": { "$ref": "#/$defs/adapter" },
    "html": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "format", "responsive", "accessibilityTarget"],
      "properties": {
        "enabled": { "type": "boolean" },
        "format": { "const": "standalone" },
        "responsive": { "type": "boolean" },
        "accessibilityTarget": { "const": "WCAG-AA" }
      }
    },
    "illustration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "candidateCount", "requireHumanApproval", "storeRejectedCandidates"],
      "properties": {
        "enabled": { "type": "boolean" },
        "candidateCount": { "type": "integer", "minimum": 1, "maximum": 8 },
        "requireHumanApproval": { "type": "boolean" },
        "storeRejectedCandidates": { "type": "boolean" }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic", "pairwiseComparison", "requireHumanReview"],
      "properties": {
        "automatic": { "type": "boolean" },
        "pairwiseComparison": { "type": "boolean" },
        "requireHumanReview": { "type": "boolean" }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordProvenance", "recordRejectedDesigns"],
      "properties": {
        "recordProvenance": { "type": "boolean" },
        "recordRejectedDesigns": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "requireExistingFile": { "type": "boolean" },
        "reuseExistingComponents": { "type": "boolean" },
        "reuseExistingVariables": { "type": "boolean" }
      }
    }
  }
}
